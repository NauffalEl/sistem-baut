# ─────────────────────────────────────────────────────────────
# Database — Supabase PostgreSQL
# ─────────────────────────────────────────────────────────────
# Connection strings dari Supabase Dashboard → Settings → Database.
#
# DATABASE_URL  → dipakai runtime aplikasi.
#   Untuk serverless (Vercel) gunakan Transaction Pooler (port 6543)
#   dengan ?pgbouncer=true agar prepared statement kompatibel.
#   Untuk VPS/long-running, pakai Session Pooler (port 5432).
#
# DIRECT_URL    → dipakai `prisma migrate deploy` dan Prisma Studio.
#   Wajib koneksi langsung (port 5432, tanpa ?pgbouncer=true).
#   Prisma memakai directUrl untuk operasi yang butuh session persisten,
#   seperti pembuatan schema saat migrasi.
#
# Contoh (ganti <project-ref>, <password>, dan <region>):
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

DATABASE_URL=""
DIRECT_URL=""

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://domain-anda.com"

# ─────────────────────────────────────────────────────────────
# Authentication (Auth.js)
# Generate dengan: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ─────────────────────────────────────────────────────────────
# Seed Production
# Dipakai oleh `npm run db:seed:prod`.
# Isi sebelum menjalankan seed. Minimal 8 karakter untuk password.
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@domain-anda.com"
ADMIN_PASSWORD="GantiDenganPasswordKuat"
ADMIN_NAME="Admin"

# ─────────────────────────────────────────────────────────────
# AI Provider (OpenAI-compatible API)
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""

# ─────────────────────────────────────────────────────────────
# OCR Provider
# ─────────────────────────────────────────────────────────────
OCR_PROVIDER="ocr.space"
OCR_API_KEY=""
OCR_BASE_URL="https://api.ocr.space/parse/image"

# ─────────────────────────────────────────────────────────────
# AI Cost Control
# ─────────────────────────────────────────────────────────────
AI_MAX_TOKENS=10000
AI_MAX_COST_PER_RUN=1.0
AI_MAX_COST_PER_DAY=10.0
AI_MAX_CALLS_PER_HOUR=20
AI_TIMEOUT_MS=120000
AI_MAX_DATA_SIZE=50000
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MS=1000

# ─────────────────────────────────────────────────────────────
# Production
# ─────────────────────────────────────────────────────────────
LOG_LEVEL="info"
ENABLE_METRICS="true"
